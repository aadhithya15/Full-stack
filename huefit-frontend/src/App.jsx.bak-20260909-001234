)}</div><div><p>{interfaceText('resultFootwear','FOOTWEAR')}</p><span>{r.footwear||'Style-matched footwear'}</span></div></div><div className="tip"><Sparkles size={16}/><span><b>{interfaceText('resultTip','Styling note')}</b>{r.styling_tips}</span></div><div className="result-actions"><button onClick={saveLook} disabled={saving||savedIds.has(r.id)}>{saving?'Savingâ€¦':savedIds.has(r.id)?interfaceText('resultSaved','â™¥ Saved look'):interfaceText('resultSave','â™¡ Save look')}</button><Link to="/compare">{interfaceText('resultCompare','Compare looks')}</Link><button onClick={generateMore} disabled={moreLoading}>{moreLoading?'Curatingâ€¦':interfaceText('resultMore','Generate more')}</button></div>{saveMessage&&<p className="save-message">{saveMessage}</p>}</section></div></div></main>}

