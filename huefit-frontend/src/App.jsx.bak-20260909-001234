function ResultView({result,gender,request,onResult,onReset}){
 const [active,setActive]=useState(0);const [savedIds,setSavedIds]=useState(()=>new Set());const [saveMessage,setSaveMessage]=useState('');const [saving,setSaving]=useState(false);const [moreLoading,setMoreLoading]=useState(false)
