rite(look)}}>{look.is_favourite?'â™¥ Favourite':'â™¡ Favourite'}</button><button onClick={e=>{e.stopPropagation();remove(look.id)}}>Remove</button></div></div></article>})}</div>}{selected&&(()=>{const r=selected.recommendation||{};return <section className="saved-detail"><button onClick={()=>setSelected(null)}>Close detail</button><div className="saved-detail-art"><PaletteVisual look={selected}/></div><div><p className="result-label">SAVED RECOMMENDATION</p><h2>{r.outfit_name||'Saved HueFit look'}</h2><p className="description">{r.description||'Your saved styling direction.'}</p><h3>WHAT TO WEAR</h3>{renderGarments(r)}<h3>COLOUR PALETTE</h3><div className="colour-chips">{(r.dress_colors||[]).map((c,i)=><span key={c.name||i}><i style={{background:c.hex}}></i>{c.name}</span>)}</div><h3>ACCESSORIES & FOOTWEAR</h3><p>{Array.isArray(r.accessories)?r.accessories.join(' Â· '):String(r.accessories||'')}</p><p>{r.footwear||''}</p></div></section>})()}</div></main>}

function DigitalCloset(){const [items,setItems]=useState([]);const [loading,setLoading]=useState(true);const [saving,setSaving]=useState(false);const [error,setError]=useState('');const [query,setQuery]=useState('');const [filter,setFilter]=useState('all');const [photo,setPhoto]=useState(null);const [preview,setPreview]=useState('');const [form,setForm]=useState({item_name:'',item_type:'shirt',colour:'',material:'let-ai-decide'});const itemTypes=[['shirt','Shirt'],['t-shirt','T-shirt'],['blouse','Blouse'],['top','Top'],['saree','Saree'],['dress','Dress'],['skirt','Skirt'],['trousers','Trousers'],['pants','Pants'],['jeans','Jeans'],['kurta','Kurta'],['blazer','Blazer'],['jacket','Jacket'],['suit','Suit'],['lehenga','Lehenga'],['shoes','Shoes'],['sandals','Sandals'],['heels','Heels'],['loafers','Loafers'],['bag','Bag'],['watch','Watch'],['accessories','Accessories'],['other','Other']];const materials=[['let-ai-decide','Let AI decide'],['cotton','Cotton'],['linen','Linen'],['silk','Silk'],['wool','Wool'],['denim','Denim'],['leather','Leather'],['velvet','Velvet'],['chiffon','Chiffon'],['georgette','Georgette'],['satin','Satin'],['khadi','Khadi'],['handloom-cotton','Handloom cotton'],['other','Other']];useEffect(()=>{api.get('/closet/items').then(({data})=>setItems(Array.isArray(data.items)?data.items:[])).catch(e=>setError(e.response?.data?.error?.message||'Could not load your closet. Please log in again.')).finally(()=>setLoading(false))},[]);const onPhoto=e=>{const file=e.target.files?.[0];if(!file)return;if(!['image/jpeg','image/png','image/webp'].includes(file.type)){setError('Choose a JPG, PNG or WebP image.');return}if(file.size>5*1024*1024){setError('Choose an image under 5 MB.');return}setPhoto(file);setPreview(URL.createObjectURL(file));setError('')};const submit=async e=>{e.preventDefault();if(!form.item_name.trim()){setError('Add a name for this wardrobe item.');return}setSaving(true);setError('');const fd=new FormData();Object.entries(form).forEach(([key,value])=>fd.append(key,value));if(photo)fd.append('image',photo);try{const {data}=await api.post('/closet/items',fd);setItems(current=>[data.item,...current]);setForm({item_name:'',item_type:'shirt',colour:'',material:'let-ai-decide'});setPhoto(null);setPreview('')}catch(err){setError(err.response?.data?.error?.message||'Could not save this closet item.')}finally{setSaving(false)}};const remove=async id=>{try{await api.delete(`/closet/items/${id}`);setItems(current=>current.filter(item=>item.id!==id))}catch(err){setError(err.response?.data?.error?.message||'Could not remove this closet item.')}};const visible=items.filter(item=>{const matchesQuery=!query||`${item.item_name} ${item.item_type} ${item.colour} ${item.material}`.toLowerCase().includes(query.toLowerCase());const matchesFilter=filter==='all'||item.item_type===filter;return matchesQuery&&matchesFilter});return <main className="utility closet-page"><div className="wide"><div className="page-visual"><img src={traditionalSareeLandscape} alt="Wardrobe silk and colour"/></div><div className="closet-heading"><div><p className="micro">{interfaceText('closetKicker','YOUR DIGITAL WARDROBE')}</p><h1>{interfaceText('closetTitle','What you already own.')}<span>.</span></h1><p>{interfaceText('closetIntro','Save your pieces once. Build smarter looks around them.')}</p></div><Link to="/analyze" className="closet-style-link">{interfaceText('closetStyle','Style my closet')} <ArrowUpRight size={16}/></Link></div><form className="closet-form" onSubmit={submit}><div className="closet-form-head"><p className="micro">{interfaceText('closetAddKicker','ADD A WARDROBE PIECE')}</p><span>{interfaceText('closetPrivate','PRIVATE TO YOUR ACCOUNT')}</span></div><div className="closet-form-grid"><label className="closet-upload">{preview?<img src={preview} alt="Selected wardrobe item"/>:<><Upload size={19}/><strong>{interfaceText('closetPhoto','Add a photo')}</strong><small>JPG, PNG or WebP Â· optional</small></>}<input type="file" accept="image/jpeg,image/png,image/webp" onChange={onPhoto}/></label><div className="closet-fields"><label>{interfaceText('closetItemName','ITEM NAME')}<input value={form.item_name} onChange={e=>setForm({...form,item_name:e.target.value})} placeholder="e.g. Navy linen shirt"/></label><label>{interfaceText('closetItemType','ITEM TYPE')}<select value={form.item_type} onChange={e=>setForm({...form,item_type:e.target.value})}>{itemTypes.map(([value,label])=><option value={value} key={value}>{optionText('dress',value,label)}</option>)}</select></label><label>{interfaceText('closetColour','COLOUR')}<input value={form.colour} onChange={e=>setForm({...form,colour:e.target.value})} placeholder="e.g. Navy blue"/></label><label>{interfaceText('closetMaterial','MATERIAL')}<select value={form.material} onChange={e=>setForm({...form,material:e.target.value})}>{materials.map(([value,label])=><option value={value} key={value}>{optionText('material',value,label)}</option>)}</select></label></div></div><button className="closet-add-button" disabled={saving}>{saving?'Savingâ€¦':'Add to my closet'} <ArrowUpRight size={16}/></button></form>{error&&<p className="form-error">{error}</p>}{!loading&&items.length>0&&<div className="closet-toolbar"><p className="micro">{items.length} WARDROBE {items.length===1?'PIECE':'PIECES'}</p><input aria-label="Search closet" value={query} onChange={e=>setQuery(e.target.value)} placeholder={interfaceText('closetSearch','Search your closet')}/><select aria-label="Filter closet" value={filter} onChange={e=>setFilter(e.target.value)}><option value="all">{interfaceText('closetAll','All pieces')}</option>{itemTypes.map(([value,label])=><option value={value} key={value}>{label}</option>)}</select></div>}{loading?<p className="save-message">Loading your closetâ€¦</p>:!loading&&items.length===0?<div className="closet-empty"><span>01</span><h2>Your wardrobe starts here.</h2><p>Add a shirt, saree, pair of shoes, or anything you reach for often.</p></div>:visible.length===0