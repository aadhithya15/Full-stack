 const saveLook=async()=>{if(saving||savedIds.has(r.id))return;try{setSaving(true);await api.post('/fashion/save',{recommendation_id:r.id,is_favourite:true});setSavedIds(ids=>new Set(ids).add(r.id));setSaveMessage('Saved to your HueFit looks.')}catch(e){setSaveMessage(e.response?.data?.error?.message||'Could not save this look. Please log in again.')}finally{setSaving(false)}}
