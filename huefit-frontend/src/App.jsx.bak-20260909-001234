   Object.entries(baseForm).forEach(([key,value])=>{if(key!=='skin_tone_text')fd.append(key,value)})
   fd.append('count','4');fd.append('exclude',JSON.stringify(recommendations.map(item=>item.outfit_name).filter(Boolean)));fd.append('avoid_repeats','true')
   const response=await api.post('/fashion/analyze',fd,{timeout:180000});onResult(response.data);setActive(0);setSavedIds(new Set());setSaveMessage('Fresh looks generated without repeating your previous edits.')
  }catch(e){setSaveMessage(e.response?.data?.error?.message||'Could not generate fresh looks. Please try again in a moment.')}finally{setMoreLoading(false)}
 }
 const colors=Array.isArray(r.dress_colors)?r.dress_colors:[];const accessories=Array.isArray(r.accessories)?r.accessories:[];const materialMatch=String(r.description||'').match(/\b(silk(?:-\w+)?|linen|cotton|georgette|chiffon|satin|velvet|wool|denim|leather|rayon|brocade|organza|crepe|viscose)\b/i);const material=materialMatch?materialMatch[1]:'weather-appropriate premium fabric';const garments=Array.isArray(r.garments)&&r.garments.length>0?r.garments:[{item:gender==='male'?'outfit':'dress / outf',name:r.outfit_name,colour:colors.map(c=>c.name).filter(Boolean).join(' + ')||'AI-selected colour palette',fabric:material}]
