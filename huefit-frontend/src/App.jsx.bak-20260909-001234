const STYLE_REFERENCE_IMAGES = [traditionalSaree, traditionalMenswear, traditionalEveryday, traditionalFusion, traditionalFestival, traditionalHero]

function referenceImageFor(look, gender='neutral', salt=''){
 const text=`${look?.outfit_name||''} ${look?.category||''} ${look?.description||''} ${salt}`.toLowerCase();
 const pool=gender==='male'?[streetLook,ceremonyLook,formalLook,heroFashion]:gender==='female'?[festivalLook,formalLook,ceremonyLook,styleCollage]:STYLE_REFERENCE_IMAGES;
 let hash=0;for(let i=0;i<text.length;i++)hash=(hash*31+text.charCodeAt(i))>>>0;
 // Use the outfit name hash for a stable but varied reference. Unlike the
 // old category-only mapping, two traditional looks do not share one poster.
 return pool[hash%pool.length];
}

