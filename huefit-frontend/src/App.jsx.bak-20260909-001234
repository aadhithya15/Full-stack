function SavedLooks(){const [looks,setLooks]=useState([]);const [loading,setLoading]=useState(true);const [error,setError]=useState('');const [query,setQuery]=useState('');const [filter,setFilter]=useState('all');const [selected,setSelected]=useState(null);useEffect(()=>{api.get('/fashion/saved').then(({data})=>setLooks(Array.isArray(data.saved_looks)?data.saved_looks:[])).catch(e=>setError(e.response?.data?.error?.message||'Could not load your saved looks.')).finally(()=>setLoading(false))},[]);const favourite=async look=>{try{const next=!look.is_favourite;await api.patch(`/fashion/saved/${look.id}`,{is_favourite:next});setLooks(items=>items.map(x=>x.id===look.id?{...x,is_favourite:next}:x));if(selected?.id===look.id)setSelected({...look,is_favourite:next})}catch{setError('Could not update favourite.')}};const remove=async id=>{try{await api.delete(`/fashion/saved/${id}`);setLooks(items=>items.filter(x=>x.id!==id));if(selected?.id===id)setSelected(null)}catch{setError('Could not remove this look.')}};const filtered=looks.filter(look=>{const r=look.recommendation||{};const matchesQuery=!query||`${r.outfit_name||''} ${r.category||''} ${r.description||''}`.toLowerCase().includes(query.toLowerCase());const matchesFilter=filter==='all'||(filter==='favourite'?look.is_favourite:(r.category||'').toLowerCase()===filter);return matchesQuery&&matchesFilter});const renderGarments=r=>Array.isArray(r?.garments)&&r.garments.length>0&&<div className="garment-grid">{r.garments.map((g,i)=><article key={`${g.item||g.type||'piece'}-${i}`}><span className="garment-kind">{g.item||g.type||'PIECE'}</span><strong>{g.name||g.description}</strong>{(g.colour||g.color)&&<small>{g.colour||g.color}</small>}{g.fabric&&<small>{g.fabric}</small>}</article>)}</div>;return <main className="utility saved-page"><div className="wide"><div className="page-visual"><img src={traditionalFestival} alt="Saved ceremonial look"/></div><div className="saved-page-head"><div><p className="micro">{interfaceText('sa