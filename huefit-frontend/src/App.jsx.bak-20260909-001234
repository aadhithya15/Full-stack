function inferredGenderFor(look){const accessories=Array.isArray(look?.accessories)?look.accessories.join(' '):String(look?.accessories||'');const text=`${look?.outfit_name||''} ${look?.description||''} ${accessories}`.toLowerCase();return /watch|loafers|blazer|shirt|trouser|kurta|bandhgala|suit/.test(text)?'male':'female'}

