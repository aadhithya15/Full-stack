function installStaticTranslations(language) {
  if (typeof document === 'undefined') return () => {}
  if (language === 'en') return () => {}
  let textOriginals = new WeakMap()
  let attributeOriginals = new WeakMap()
  const apply = () => {
    const dictionary = STATIC_TRANSLATIONS[language] || {}
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
    let node
    while (node = walker.nextNode()) {
      const parent = node.parentElement
      if (!parent || ['SCRIPT','STYLE','NOSCRIPT'].includes(parent.tagName)) continue
      if (!textOriginals.has(node)) textOriginals.set(node, node.nodeValue)
      const original = textOriginals.get(node)
      const clean = original.trim()
      if (!clean) continue
      const translated = dictionary[clean]
      const nextValue = language === 'en' ? original : (translated ? original.replace(clean, translated) : original)
      if (node.nodeValue !== nextValue) node.nodeValue = nextValue
    }
    document.querySelectorAll('input, textarea, [aria-label], [title]').forEach(element => {
      const attrs = attributeOriginals.get(element) || {}
      for (const attr of ['placeholder','aria-label','title']) {
        if (!element.hasAttribute(attr)) continue
        if (!attrs[attr]) attrs[attr] = element.getAttribute(attr)
        const original = attrs[attr]
        const translated = dictionary[original]
        const nextValue = language === 'en' ? original : (translated || original)
        if (element.getAttribute(attr) !== nextValue) element.setAttribute(attr, nextValue)
      }
      attributeOriginals.set(element, attrs)
    })
  }
  apply()
  const observer = new MutationObserver(apply)
  observer.observe(document.body, {childList:true,subtree:true,characterData:true})
  return () => observer.disconnect()
}

let ACTIVE_UI_LANGUAGE = localStorage.getItem('huefit_language') || 'en'
function interfaceText(key, fallback='') { return UI_TEXT[ACTIVE_UI_LANGUAGE]?.[key] || UI_TEXT.en[key] || fallback }
function useInterfaceLanguage() {
  const [language, setLanguage] = useState(() => localStorage.getItem('huefit_language') || 'en')
  useEffect(() => {
    const sync = () => { const next = localStorage.getItem('huefit_language') || 'en'; ACTIVE_UI_LANGUAGE = next; if (typeof document !== 'undefined') document.documentElement.lang = next; setLanguage(next) }
    window.addEventListener('huefit-language-change', sync)
    return () => window.removeEventListener('huefit-language-change', sync)
  }, [])
  ACTIVE_UI_LANGUAGE = language
  if (typeof document !== 'undefined') document.documentElement.lang = language
  return language
}

