function CompareLooks(){
 const [looks,setLooks]=useState([]);const [loading,setLoading]=useState(true);const [error,setError]=useState('');const [selected,setSelected]=useState([])
 useEffect(()=>{api.get('/fashion/saved').then(({data})=>setLooks(Array.isArray(data.saved_looks)?data.saved_looks:[])).catch(e=>setError(e.response?.data?.error?.message||'Could not load your saved looks.')).finally(()=>setLoading(false))},[])
 const toggle=id=>setSelected(current=>current.includes(id)?current.filter(value=>value!==id):(current.length<2?[...current,id]:[current[1],id]))
 const updateFavourite=async look=>{try{const next=!look.is_favourite;await api.patch(`/fashion/saved/${look.id}`,{is_favourite:next});setLooks(items=>items.map(item=>item.id===look.id?{...item,is_favourite:next}:item))}catch{setError('Could not update favourite.')}}
 const selectedLooks=selected.map(id=>looks.find(look=>look.id===id)).filter(Boolean)
 const value=(look,key,fallback='â€”')=>{const r=look?.recommendation||{};if(key==='garments')return (r.garments||[]).map(g=>g.name||g.item).join(' Â· ')||fallback;if(key==='materials')return (r.materials||[]).join(' Â· ')||fallback;if(key==='colours')return (r.dress_colors||[]).map(c=>c.name).join(' Â· ')||fallback;if(key==='accessories')return Array.isArray(r.accessories)?r.accessories.join(' Â· '):r.accessories||fallback;return r[key]||fallback}
 return <main className="utility"><div className="wide"><p className="micro">{interfaceText('compareKicker','SELECT TWO LOOKS TO COMPARE')}</p><h1>{interfaceText('compareTitle','Compare your edits.')}</h1>{loading?<p className="save-message">{interfaceText('commonLoading','Loadingâ€¦')}</p>:error?<p className="form-error">{error}</p>:looks.length===0?<div className="compare-note">No saved looks yet. Save at least two recommendations to compare them.</div>:<><div className="compare-live-grid">{looks.map(look=>{const r=look.recommendation||{};const chosen=selected.includes(look.id);return <article className={`compare-live-card ${chosen?'selected-look':''}`} key={look.id}><button className="compare-select-card" onClick={()=>toggle(look.id)} aria-pressed={chosen}><PaletteVisual look={look}/><div className="compare-live-copy"><span>{r.category||r.outfit_type||'PERSONAL EDIT'}</span><h2>{r.outfit_name||'Saved HueFit look'}</h2><small>{r.match_score||'â€”'}% match</small><b>{chosen?interfaceText('compareSelected','âœ“ Selected'):interfaceText('compareSelect','Select look')}</b></div></button><button className="compare-favourite" onClick={()=>updateFavourite(look)}>{look.is_favourite?'â™¥ Favourite':'â™¡ Favourite'}</button></article>})}</div>{selectedLooks.length===2&&<section className="comparison"><p className="micro">{interfaceText('compareHeading','HUEFIT LOOK COMPARISON')}</p><div className="compare-table"><span>Detail</span>{selectedLooks.map(look=><b key={look.id}>{value(look,'outfit_name')}</b>)}<span>Outfit type</span>{selectedLooks.map(look=><p key={look.id}>{value(look,'outfit_type',value(look,'category'))}</p>)}<span>Match score</span>{selectedLooks.map(look=><p key={look.id}>{value(look,'match_score')}%</p>)}<span>Garments</span>{selectedLooks.map(look=><p key={look.id}>{value(look,'garments')}</p>)}<span>Materials</span>{selectedLooks.map(look=><p key={look.id}>{value(look,'materials')}</p>)}<span>Colours</span>{selectedLooks.map(look=><p key={look.id}>{value(look,'colours')}</p>)}<span>Accessories</span>{selectedLooks.map(look=><p key={look.id}>{value(look,'accessories')}</p>)}<span>Footwear</span>{selectedLooks.map(look=><p key={look.id}>{value(look,'footwear')}</p>)}</div><div className="ai-pick">âœ¦ <b>{interfaceText('comparePick','HueFit Pick:')}</b> {selectedLooks[0].recommendation?.match_score>=selectedLooks[1].recommendation?.match_score?selectedLooks[0].recommendation?.outfit_name:selectedLooks[1].recommendation?.outfit_name} has the stronger match score for this comparison.</div></section>}</>}</div></main>}

