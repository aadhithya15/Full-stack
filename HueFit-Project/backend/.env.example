# HueFit backend environment
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real keys.

# Flask
FLASK_ENV=development
PORT=5000

# CORS - comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=5

# Supabase - Dashboard > Settings > API
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_HERE

# AI providers
# Gemini remains the primary final recommendation model when configured.
GEMINI_API_KEY=PLACEHOLDER_REPLACE_WHEN_AVAILABLE

# A real Groq key enables the internal live-research step on every production
# outfit analysis through groq/compound-mini (with groq/compound fallback).
# The research sources and citations stay internal; the frontend response
# contract does not change. Groq can also generate the final JSON if Gemini
# is unavailable.
GROQ_API_KEY=PLACEHOLDER_REPLACE_WHEN_AVAILABLE
